[TEMPLATE]
# IncidentIQ — environment configuration template
# Copy to .env.local (Next.js) and backend/.env (FastAPI) and fill in real values.
# NEVER commit .env.local or backend/.env.

# ── Hindsight Cloud (Next.js server-side only — required for real memory) ──
# Get your API key at https://ui.hindsight.vectorize.io/connect
# This key is read ONLY by server code (route handlers / server components).
# It is never sent to the browser.
HINDSIGHT_API_KEY=

# Hindsight Cloud API endpoint (default shown; override only for self-hosted)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Memory bank ID that stores IncidentIQ incident knowledge
HINDSIGHT_BANK_ID=incidentiq

# ── FastAPI analysis backend (server-to-server from Next.js) ────────────────
# URL of the analysis service (backend/main.py). Server-side only.
ANALYSIS_API_URL=http://127.0.0.1:8000
# When set, the UI reads incidents from the FastAPI backend instead of demo data.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── FastAPI backend process (.env for backend/) ─────────────────────────────
# LLM used by the analysis agent. Provider "openai" uses OPENAI_API_KEY.
# Set LLM_PROVIDER=none to run the deterministic heuristic analyzer instead.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
